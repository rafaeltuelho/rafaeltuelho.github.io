---
import '@fontsource-variable/geist';
import '../styles/global.css';
import ThemePicker from '../components/ThemePicker.astro';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
}

const { title, description = SITE_DESCRIPTION, type = 'website', pubDate, updatedDate } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · Exploring agentic AI`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isAbout = Astro.url.pathname.startsWith('/about');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta name="twitter:card" content="summary" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <script is:inline>
      // Run before paint so a saved preference never flashes the opposite theme.
      let preference = 'system';
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') preference = saved;
      } catch {}
      document.documentElement.dataset.theme = preference === 'system'
        ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        : preference;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a href="/" class="wordmark" aria-label="Rafael Tuelho home">rafael tuelho<span>.</span></a>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={!isAbout && Astro.url.pathname === '/' ? 'page' : undefined}>Writing</a>
          <a href="/about/" aria-current={isAbout ? 'page' : undefined}>About</a>
          <ThemePicker />
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
        <a href={GITHUB_URL}>GitHub</a>
      </footer>
    </div>
  </body>
</html>
